# Public demo safety switch. Keep true on Hugging Face Space.
DEMO_MODE=true

# Live external runs are blocked unless explicitly enabled.
ALLOW_LIVE_RUNS=false

# Allows visitors to run live evaluations with their own session-only key.
VISITOR_LIVE_RUNS=true

# Optional API key for local/private live benchmark runs.
OPENAI_API_KEY=

# Optional Hugging Face token (only if gated model downloads are required).
HF_TOKEN=

# Dashboard + CLI defaults.
DEFAULT_CONFIG_PATH=evals/config.yaml
REPORTS_DIR=reports
BENCHMARK_MODE=demo

# Runtime behavior.
MPLBACKEND=Agg
STREAMLIT_SERVER_PORT=8501
